          <div class="color-name">Surface 3</div>
          <div class="color-hex">#1e2840</div>
          <div class="color-role">Hover e controles</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#6c63ff"></div>
        <div class="color-info">
          <div class="color-name">Primary</div>
          <div class="color-hex">#6c63ff</div>
          <div class="color-role">Ações e destaques</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#5a52e0"></div>
        <div class="color-info">
          <div class="color-name">Primary Hover</div>
          <div class="color-hex">#5a52e0</div>
          <div class="color-role">Estado hover</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#e8eaf0"></div>
        <div class="color-info">
          <div class="color-name">Text</div>
          <div class="color-hex">#e8eaf0</div>
          <div class="color-role">Texto principal</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#8890a4"></div>
        <div class="color-info">
          <div class="color-name">Text Muted</div>
          <div class="color-hex">#8890a4</div>
          <div class="color-role">Labels e metadados</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#22c55e"></div>
        <div class="color-info">
          <div class="color-name">Green</div>
          <div class="color-hex">#22c55e</div>
          <div class="color-role">Disponível / Sucesso</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#f97316"></div>
        <div class="color-info">
          <div class="color-name">Orange</div>
          <div class="color-hex">#f97316</div>
          <div class="color-role">Ocupado / Alerta</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#ef4444"></div>
        <div class="color-info">
          <div class="color-name">Red</div>
          <div class="color-hex">#ef4444</div>
          <div class="color-role">Erro / Indisponível</div>
        </div>
      </div>
      <div class="color-swatch">
        <div class="color-block" style="background:#3b82f6"></div>
