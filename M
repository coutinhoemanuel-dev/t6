          <div class="color-name">Blue</div>
          <div class="color-hex">#3b82f6</div>
          <div class="color-role">Informação</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TIPOGRAFIA -->
  <div class="section">
    <div class="section-title">Tipografia — Inter</div>
    <
